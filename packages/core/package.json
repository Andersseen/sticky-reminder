{
  "name": "@sticky-reminder/core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript reminder logic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit && biome check .",
