{
  "name": "@sticky-reminder/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Web Components library for Sticky Reminder",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": {
      "import": "./styles/base.css"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit && biome check .",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@vitest/browser": "^3.0.0",
    "happy-dom": "^17.0.0",
    "jsdom": "^30.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
