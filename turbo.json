{
  "$schema": "https://turbo.build/schema.json",
  // The last two are read across package boundaries, which Turbo cannot infer:
  // a task only hashes files inside its own package, and `inputs` cannot point
  // outside one. The site's build reads the extension's version and both builds
  // read the site address, so without these a version bump or a moved domain
  // would be served from a cache that predates it — which is how the site's
  // version badge sat at v0.2.0 through the whole 0.3.0 release.
  "globalDependencies": [
    "**/.env.*local",
    "**/tsconfig*.json",
    "site.config.mjs",
    "apps/extension/package.json"
  ],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Turbo runs tasks in strict env mode, so the site's deploy-time origin,
      // base path and canonical have to be declared to reach the Astro build.
      // CF_PAGES_URL is the one Cloudflare injects rather than the workflow.
      "env": ["SITE_URL", "SITE_BASE", "SITE_CANONICAL", "CF_PAGES_URL"],
      "outputs": ["dist/**", "build/**", ".output/**", ".wxt/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    // Nothing runs `turbo run test` — the root script drives vitest directly so
    // that one run covers every project and the coverage thresholds apply to
    // the whole workspace. That means this `dependsOn` never fires, and the
    // root script builds the libraries itself; the tests import them through
    // their package entries, which point at dist. Kept so a direct
    // `turbo run test` is not silently missing the build.
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
