{
  "name": "@sticky-reminder/extension",
  "version": "0.3.0",
  "private": true,
  "description": "Sticky Reminder browser extension (WXT + Web Components)",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:browser": "pnpm build && node scripts/open-dev-browser.mjs",
    "dev:browser:options": "pnpm build && node scripts/open-dev-browser.mjs options",
    "dev:browser:smoke": "pnpm build && node scripts/open-dev-browser.mjs --smoke",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "tsc --noEmit && biome check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "store:assets": "node scripts/capture-store-assets.mjs",
    "clean": "rm -rf .wxt dist .output"
  },
  "dependencies": {
    "@andersseen/layout": "^0.0.1",
    "@andersseen/motion": "^0.2.0",
    "@andersseen/web-components": "^0.4.1",
    "@sticky-reminder/core": "workspace:*",
    "@sticky-reminder/ui": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.300",
    "@vitest/browser": "^4.1.10",
    "happy-dom": "^20.11.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wxt": "^0.21.4"
  }
}
