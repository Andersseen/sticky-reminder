---
import '../styles/base.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { url, SITE_DESCRIPTION, SITE_NAME } from '../lib/site';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE_NAME} — reminders that stay in your browser`,
  description = SITE_DESCRIPTION,
} = Astro.props;

// Astro.site is unset in some dev setups; the fallback keeps the tags valid.
const origin = Astro.site ?? new URL('http://localhost:4321');

// The site ships to two origins — Cloudflare Pages at the root and GitHub Pages
// under /<repo>/ — so without a shared canonical the two look like duplicates.
// SITE_CANONICAL names the origin that owns the pages; the deploy base is
// stripped off the path first, because it does not survive the origin swap.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = Astro.url.pathname.slice(base.length) || '/';
const canonicalOrigin = process.env.SITE_CANONICAL;
const canonical = canonicalOrigin ? new URL(route, canonicalOrigin) : new URL(url(route), origin);

// Unlike the canonical, the preview image is served by whichever origin the
// page was fetched from, so it keeps that deploy's base path.
const ogImage = new URL(url('/og.png'), origin);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/icon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#4f46e5" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Applied before first paint: a stored choice must not flash the other
         theme while the module script is still loading. -->
    <script is:inline>
      const mode = localStorage.getItem('sr-theme');
      if (mode === 'dark' || mode === 'light') {
        document.documentElement.setAttribute('data-mode', mode);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script>
      // Must stay above the component imports: it fills the icon registry, and
      // defining an `and-*` element renders every icon inside it against
      // whatever the registry holds at that instant.
      import '@sticky-reminder/ui/icons';
      import '@andersseen/web-components/components/and-badge.js';
      import '@andersseen/web-components/components/and-button.js';
      import '@andersseen/web-components/components/and-icon.js';
      import { MotionController } from '@andersseen/motion';

      new MotionController().scan();

      const root = document.documentElement;
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const mode = root.getAttribute('data-mode');
        const isDark = mode ? mode === 'dark' : prefersDark.matches;
        const next = isDark ? 'light' : 'dark';

        root.setAttribute('data-mode', next);
        localStorage.setItem('sr-theme', next);
      });
    </script>
  </body>
</html>
