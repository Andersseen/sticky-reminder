---
/**
 * A static rendering of the extension sidebar, drawn from the same tokens as the
 * real thing. Deliberately not the live components: the hero has to be right on
 * first paint, with no JavaScript and no screenshot to keep in sync.
 */
import { url } from '../lib/site';
---

<div class="browser-mock" and-motion="fade-in-up">
  <div class="browser-bar" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    <div class="browser-address">andersseen.dev</div>
  </div>

  <div class="browser-body">
    <div class="browser-page" aria-hidden="true">
      <span class="page-line wide"></span>
      <span class="page-line"></span>
      <span class="page-line short"></span>
      <div class="page-block"></div>
    </div>

    <aside class="mock">
      <div class="mock-bar">
        <img src={url('/icon.svg')} alt="" width="20" height="20" />
        <span class="mock-bar-title">Sticky Reminder</span>
      </div>

      <div class="mock-body">
        <div class="mock-input">Water the plants</div>
        <div class="mock-chips">
          <span class="mock-chip">In 1 hour</span>
          <span class="mock-chip" data-active>This evening</span>
        </div>

        <p class="mock-label">Upcoming</p>

        <div class="mock-item" data-state="overdue">
          <span class="mock-check" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          </span>
          <span>
            <span class="mock-title">
              Call the dentist
              <span class="mock-badge">Weekly</span>
            </span>
            <span class="mock-when"><strong>3 hours ago</strong> · Today, 14:00</span>
          </span>
        </div>

        <div class="mock-item">
          <span class="mock-check" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          </span>
          <span>
            <span class="mock-title">
              Daily standup
              <span class="mock-badge">Daily</span>
            </span>
            <span class="mock-when"><strong>in 24 minutes</strong> · Today, 17:00</span>
          </span>
        </div>
      </div>

      <div class="mock-toast" and-motion="fade-in-right">
        <span class="mock-toast-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
        </span>
        <span>
          <span class="mock-toast-title">Daily standup</span>
          <span class="mock-toast-body">Join the team call · 17:00</span>
        </span>
      </div>
    </aside>
  </div>
</div>
