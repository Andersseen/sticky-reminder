---
import { listReminders } from '@sticky-reminder/core';
import Layout from '../layouts/Layout.astro';

const exampleReminders = listReminders([
  {
    id: '1',
    title: 'Daily standup',
    body: 'Join the team meeting',
    createdAt: new Date().toISOString(),
    updatedAt: new Date().toISOString(),
    scheduledAt: new Date(Date.now() + 3600_000).toISOString(),
    repeat: 'daily',
    completed: false,
  },
  {
    id: '2',
    title: 'Review PRs',
    body: 'Check open pull requests',
    createdAt: new Date().toISOString(),
    updatedAt: new Date().toISOString(),
    scheduledAt: new Date(Date.now() + 7200_000).toISOString(),
    repeat: 'none',
    completed: false,
  },
]);

const features = [
  { icon: 'check', title: 'One click', body: 'Create reminders without leaving the page.' },
  { icon: 'bell', title: 'Native notifications', body: 'Your browser tells you when it is time.' },
  { icon: 'refresh-cw', title: 'Daily or weekly', body: 'Repeating reminders keep coming back.' },
];
---

<Layout title="Sticky Reminder — Remember what matters">
  <main class="landing" and-layout="vertical gap:xxl p:lg">
    <section class="hero" and-layout="vertical align:center gap:sm p-y:xxl" and-motion="fade-in">
      <h1 class="hero-title">Sticky Reminder</h1>
      <p class="lead">Browser reminders that stick with you.</p>
      <and-button href="/download" size="lg">Install extension</and-button>
    </section>

    <section and-layout="vertical gap:md">
      <h2 class="section-title">Features</h2>
      <div and-layout="horizontal wrap:wrap gap:md">
        {
          features.map((feature) => (
            <and-card class="feature" padded and-motion="slide-in-up">
              <and-icon name={feature.icon} size="20" />
              <h3 class="feature-title">{feature.title}</h3>
              <p class="muted">{feature.body}</p>
            </and-card>
          ))
        }
      </div>
    </section>

    <section and-layout="vertical gap:md">
      <h2 class="section-title">Example reminders</h2>
      <div and-layout="vertical gap:xs">
        {
          exampleReminders.map((reminder) => (
            <and-card padded and-motion="fade-in">
              <div and-layout="horizontal justify:between align:center gap:sm">
                <div and-layout="vertical gap:xxxs">
                  <strong>{reminder.title}</strong>
                  <span class="muted">{reminder.body}</span>
                </div>
                {reminder.repeat !== 'none' && (
                  <and-badge variant="secondary">
                    <and-icon name="refresh-cw" size="12" />
                    {reminder.repeat === 'daily' ? 'Daily' : 'Weekly'}
                  </and-badge>
                )}
              </div>
            </and-card>
          ))
        }
      </div>
    </section>
  </main>

  <script>
    import '@andersseen/web-components/components/and-badge.js';
    import '@andersseen/web-components/components/and-button.js';
    import '@andersseen/web-components/components/and-card.js';
    import '@andersseen/web-components/components/and-icon.js';
    import { MotionController } from '@andersseen/motion';
    import { registerStickyIcons } from '@sticky-reminder/ui';

    registerStickyIcons();
    new MotionController().scan();
  </script>
</Layout>
