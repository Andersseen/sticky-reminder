---
import PopupMock from '../components/PopupMock.astro';
import Layout from '../layouts/Layout.astro';
import { url, CHROME_STORE_URL, REPO_URL } from '../lib/site';

const features = [
  {
    icon: 'zap',
    title: 'Sidebar-first, popup-ready',
    body: 'Keep reminders beside the page in supported browsers, or use the toolbar popup for the same one-click flow.',
  },
  {
    icon: 'bell',
    title: 'Notifications your OS shows',
    body: 'Reminders fire through the browser’s own notification system, so they reach you even when the tab that created them is long gone.',
  },
  {
    icon: 'refresh-cw',
    title: 'Daily and weekly repeats',
    body: 'A repeating reminder rolls itself forward the moment it fires — and skips the periods it slept through instead of firing a backlog.',
  },
  {
    icon: 'search',
    title: 'Overdue at a glance',
    body: 'Late reminders turn red and say how late. Search and filter the full list from the options page.',
  },
  {
    icon: 'download',
    title: 'Portable local backups',
    body: 'Export every reminder to a readable JSON file and merge it back in whenever you need it. No cloud or extra permission involved.',
  },
  {
    icon: 'lock',
    title: 'Stays on your machine',
    body: 'Everything lives in your browser’s local storage. No server, no sync, no analytics, no third-party requests.',
  },
  {
    icon: 'code',
    title: 'Open source, MIT',
    body: 'Read every line, build it yourself, or fork it. Three permissions, no minified mystery bundle.',
  },
];

const steps = [
  {
    title: 'Install and open the sidebar',
    body: 'Use the official store build when available, or load the release manually. The sidebar sits next to the page instead of covering it.',
  },
  {
    title: 'Write the reminder',
    body: 'A title, an optional note, and a time — or one of the shortcuts: in an hour, this evening, tomorrow at nine.',
  },
  {
    title: 'Get told, on time',
    body: 'The reminder fires as a native notification. Click it to jump straight to that reminder in the full list.',
  },
];

const permissions = [
  {
    name: 'alarms',
    body: 'Schedules the moment a reminder is due. Without it nothing can fire while the popup is closed.',
  },
  {
    name: 'notifications',
    body: 'Shows the notification when the time comes. That is the whole product.',
  },
  {
    name: 'storage',
    body: 'Keeps your reminders in this browser’s local storage. Local only — there is nothing to sync to.',
  },
];

const faq = [
  {
    q: 'Do my reminders leave my computer?',
    a: 'No. They are written to your browser’s local storage and read back from there. The extension makes no network requests at all, which is also why there is no cross-device sync.',
  },
  {
    q: 'Does it work when the browser is closed?',
    a: 'The browser must be running to show a notification. A missed one-time reminder fires when the browser starts again; repeating reminders resume at their next occurrence instead of firing every missed interval.',
  },
  {
    q: 'Which browsers are supported?',
    a: 'Chrome, Edge and any other Chromium browser through the MV3 build, plus Firefox through its own build. Supported browsers get a native sidebar; the toolbar popup remains available as a compact fallback.',
  },
  {
    q: 'Is it on the Chrome Web Store?',
    a: CHROME_STORE_URL
      ? 'Yes. Use the install page to open the signed Chrome Web Store listing. Store installations update automatically.'
      : 'Store publication is in progress. Until the signed listing is live, use the verified build from the releases page — the download page walks through it.',
  },
  {
    q: 'What happens to a repeating reminder I never tick off?',
    a: 'It moves to its next occurrence each time it fires. Leave a daily one alone for a month and it will not fire thirty times: it jumps to the next occurrence from now.',
  },
];
---

<Layout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="pill" and-motion="fade-in">
          <and-icon name="star" size="12"></and-icon>
          v0.2.0 · Free and open source
        </span>

        <h1 class="hero-title">
          Reminders that <span class="accent">actually reach you</span>.
        </h1>

        <p class="hero-lead">
          Sticky Reminder lives beside your browser viewport. Keep it open as a calm sidebar,
          write a reminder in a click, and get a native notification when it is due.
        </p>

        <div class="hero-actions">
          <and-button href={url('/download')} size="lg">Install the extension</and-button>
          <and-button href={REPO_URL} variant="outline" size="lg" rel="noreferrer">
            View the source
          </and-button>
        </div>

        <div class="trust-row">
          <span class="pill"><and-icon name="lock" size="12"></and-icon> No account</span>
          <span class="pill"><and-icon name="check" size="12"></and-icon> No tracking</span>
          <span class="pill"><and-icon name="code" size="12"></and-icon> MIT licensed</span>
        </div>
      </div>

      <PopupMock />
    </div>
  </section>

  <section class="section" id="how-it-works">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 class="section-title">Three steps, then forget about it</h2>
        <p class="section-lead">
          The whole point is not having to remember. Set it once and let the browser carry it.
        </p>
      </div>

      <div class="steps">
        {
          steps.map((step) => (
            <article class="step" and-motion="fade-in-up">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="features">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Features</p>
        <h2 class="section-title">Small on purpose, complete on purpose</h2>
        <p class="section-lead">
          Everything a reminder needs and nothing that turns it into another inbox to manage.
        </p>
      </div>

      <div class="card-grid">
        {
          features.map((feature) => (
            <article class="tile" and-motion="fade-in-up">
              <span class="tile-icon">
                <and-icon name={feature.icon} size="20" />
              </span>
              <h3 class="tile-title">{feature.title}</h3>
              <p>{feature.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section band" id="privacy">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Privacy</p>
        <h2 class="section-title">Three permissions, and here is what each one is for</h2>
        <p class="section-lead">
          An extension that watches your browsing does not need to say this. This one does not
          request host permissions at all, so it cannot read a single page you visit.
        </p>
      </div>

      <div class="permissions">
        {
          permissions.map((permission) => (
            <div class="permission" and-motion="fade-in">
              <code>{permission.name}</code>
              <p>{permission.body}</p>
            </div>
          ))
        }
      </div>
      <p class="privacy-link">
        Read the complete <a href={url('/privacy')}>privacy policy</a>, including retention and
        deletion details.
      </p>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2 class="section-title">Questions worth answering up front</h2>
      </div>

      <div class="faq">
        {
          faq.map((entry) => (
            <details>
              <summary>{entry.q}</summary>
              <p>{entry.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta" and-motion="fade-in">
        <h2 class="section-title">Keep it beside your work</h2>
        <p class="section-lead" style="text-align: center;">
          Install it once, open the sidebar, and let the next thing you would have forgotten find
          you instead.
        </p>
        <and-button href={url('/download')} size="lg">Install the extension</and-button>
      </div>
    </div>
  </section>
</Layout>
