---
import Layout from '../layouts/Layout.astro';
import {
  CHROME_STORE_URL,
  EDGE_STORE_URL,
  FIREFOX_STORE_URL,
  ISSUES_URL,
  LATEST_RELEASE_URL,
  REPO_URL,
} from '../lib/site';

const hasOfficialStore = Boolean(CHROME_STORE_URL || EDGE_STORE_URL || FIREFOX_STORE_URL);
---

<Layout
  title="Install Sticky Reminder"
  description="Install Sticky Reminder in Chrome, Edge or Firefox — the build for each is attached to every release."
>
  <section class="container page-head">
    <p class="eyebrow">Install</p>
    <h1 class="page-title">Get Sticky Reminder</h1>
    <p class="section-lead">
      {
        hasOfficialStore
          ? 'Install the signed extension from your browser’s official store. Updates arrive automatically.'
          : 'The signed store listings are being prepared. Until review is complete, every release includes verified builds for Chromium and Firefox.'
      }
    </p>

    {
      hasOfficialStore ? (
        <div class="hero-actions" style="margin-top: 1.5rem;">
          {CHROME_STORE_URL && (
            <and-button href={CHROME_STORE_URL} size="lg" rel="noreferrer">
              Install for Chrome
            </and-button>
          )}
          {EDGE_STORE_URL && (
            <and-button href={EDGE_STORE_URL} size="lg" rel="noreferrer">
              Install for Edge
            </and-button>
          )}
          {FIREFOX_STORE_URL && (
            <and-button href={FIREFOX_STORE_URL} size="lg" rel="noreferrer">
              Install for Firefox
            </and-button>
          )}
        </div>
      ) : (
        <p class="store-status" style="margin-top: 1.5rem;">
          Store review pending · manual installation remains available below
        </p>
      )
    }
  </section>

  <section class="section" style="padding-top: 2rem;">
    <div class="container section-head">
      <p class="eyebrow">Manual installation</p>
      <h2 class="section-title">Verified release builds</h2>
      <p class="section-lead">
        Useful before store review finishes, for development testing, or if you prefer to inspect
        the ZIP yourself.
      </p>
      <div class="hero-actions">
        <and-button href={LATEST_RELEASE_URL} size="lg" rel="noreferrer">
          <and-icon name="download" size="16"></and-icon>
          Download the latest release
        </and-button>
        <and-button href={REPO_URL} variant="outline" size="lg" rel="noreferrer">
          Build it yourself
        </and-button>
      </div>
    </div>
    <div class="container install-grid">
      <article class="install-card" and-motion="fade-in-up">
        <h2>Chrome, Edge, Brave, Arc</h2>
        <p class="muted">Anything Chromium, using the MV3 build.</p>
        <ol>
          <li>Download <code>sticky-reminder-*-chrome.zip</code> from the latest release and unzip it.</li>
          <li>Open <code>chrome://extensions</code> or <code>edge://extensions</code> and turn on <strong>Developer mode</strong>.</li>
          <li>Click <strong>Load unpacked</strong> and choose the unzipped folder.</li>
          <li>Pin the icon, then use the popup’s sidebar button to keep Sticky Reminder beside the page.</li>
        </ol>
      </article>

      <article class="install-card" and-motion="fade-in-up">
        <h2>Firefox</h2>
        <p class="muted">Using the Firefox build from the same release.</p>
        <ol>
          <li>Download <code>sticky-reminder-*-firefox.zip</code> from the latest release.</li>
          <li>Open <code>about:debugging#/runtime/this-firefox</code>.</li>
          <li>Click <strong>Load Temporary Add-on</strong> and select the ZIP.</li>
          <li>Open it from Firefox’s sidebar menu, then pin it to the toolbar for the compact popup.</li>
        </ol>
      </article>
    </div>

    <div class="container dev-panel">
      <div>
        <p class="eyebrow">Developer flow</p>
        <h2 class="section-title">Run it from source</h2>
        <p class="section-lead">
          For local work, use the WXT dev server so browser builds, manifest variants and sidebar
          entrypoints stay in sync.
        </p>
      </div>
      <ol class="dev-steps">
        <li><code>pnpm install</code></li>
        <li><code>pnpm --filter @sticky-reminder/extension dev</code></li>
        <li>Load <code>apps/extension/.output/chrome-mv3</code> from <code>chrome://extensions</code>.</li>
        <li>For Firefox checks, run <code>pnpm --filter @sticky-reminder/extension build:firefox</code> and load the Firefox output.</li>
      </ol>
    </div>

    <div class="container" style="margin-top: 1.25rem; display: grid; gap: 0.75rem;">
      <p class="note">
        <and-icon name="bell" size="16"></and-icon>
        <span>
          A temporary add-on in Firefox is removed when the browser restarts — that is Firefox's
          rule for unsigned builds, not a limit of the extension. The Chromium build survives
          restarts.
        </span>
      </p>
      <p class="note">
        <and-icon name="code" size="16"></and-icon>
        <span>
          Prefer to build from source? Use the developer flow above. The same reminder UI now ships
          as a popup and as a browser sidebar.
        </span>
      </p>
      <p class="note">
        <and-icon name="github" size="16"></and-icon>
        <span>
          Something not working? <a href={ISSUES_URL} rel="noreferrer">Open an issue</a> — include
          your browser and version.
        </span>
      </p>
    </div>
  </section>
</Layout>
